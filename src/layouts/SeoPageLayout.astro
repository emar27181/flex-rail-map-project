---
/**
 * 駅・路線・データのページ（/stations, /lines, /data と各言語版）の共通レイアウト。
 *
 * 構成: パンくず → H1 → 要約（lede）→ 本文（slot）→ 別言語版へのリンク → フッター。
 * <head> は SeoHead、パンくずの構造化データは画面のパンくずと同じ並びから作る。
 * hreflang と右上の言語切り替え（LanguageSwitcher）は、langPaths に渡した（実際に作っている）言語版だけに張る。
 * 中国語・韓国語版は一部のページにしか無いため、ページごとに渡すこと。
 */
import SeoHead from '../components/seo/SeoHead.astro';
import ThemeInitScript from '../components/ThemeInitScript.astro';
import SiteFooterNav from '../components/SiteFooterNav.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import LanguageSuggestion from '../components/LanguageSuggestion.astro';
import SimpleThemeWrapper from '../components/SimpleThemeWrapper.tsx';
import { staticPageCss } from './staticPageStyles';
import { guideCss } from './guideStyles';
import { seoPageCss } from './seoPageStyles';
import { buildBreadcrumbJsonLd, buildHreflangLinks, hreflangCode, type BreadcrumbItem } from '../config/seo';
import type { SeoLang } from '../seo/pageModel';
import { SEO_LANGS } from '../seo/pageModel';
import { MAP_EMBED_SCRIPT } from '../components/ui/atoms/mapEmbed';
import { darkenForWhiteText } from '../utils/contrast';
import { adjustRouteColorForTheme } from '../contexts/ThemeContext';

export interface Props {
  lang: SeoLang;
  title: string;
  description: string;
  path: string;
  /** 同じページの各言語版のパス（作っている言語だけ。自分自身も含める） */
  langPaths: Partial<Record<SeoLang, string>>;
  /** ホームから今のページまで（最後が今のページ） */
  breadcrumbs: BreadcrumbItem[];
  h1: string;
  lede?: string;
  indexable: boolean;
  /**
   * ページの差し色（路線のページは路線色）。見出しの線・表の番号・埋め込みの枠に使う。
   * ライトは白地で読める濃さに、ダークは暗い地で見える明るさにそろえる（色相は変えない）
   */
  accent?: string;
}

const { lang, title, description, path, langPaths, breadcrumbs, h1, lede, indexable, accent } = Astro.props;
const accentVars = accent
  ? `--page-accent-light: ${darkenForWhiteText(accent)}; --page-accent-dark: ${adjustRouteColorForTheme(accent, 'dark')};`
  : undefined;
const versions = SEO_LANGS.filter(l => langPaths[l]).map(l => ({ lang: l, path: langPaths[l]! }));
const hreflang = buildHreflangLinks(versions, 'ja');
---

<html lang={hreflangCode(lang)}>
	<head>
		<SeoHead
			title={title}
			description={description}
			path={path}
			lang={lang}
			robots={indexable ? 'index, follow' : 'noindex, follow'}
			hreflang={hreflang}
			jsonLd={[buildBreadcrumbJsonLd(breadcrumbs)]}
			styles={[staticPageCss, guideCss, seoPageCss]}
		/>
	</head>
	<body style={accentVars}>
		<ThemeInitScript />
		<div class="container">
			<div class="page-lang-bar">
				<LanguageSwitcher current={lang} versions={langPaths} />
			</div>
			<LanguageSuggestion current={lang} versions={langPaths} />
			<nav class="breadcrumb">
				{breadcrumbs.map((b, i) => (
					i < breadcrumbs.length - 1
						? <Fragment><a href={b.path}>{b.name}</a> / </Fragment>
						: <span>{b.name}</span>
				))}
			</nav>

			<h1 class="page-title">{h1}</h1>
			{lede && <p class="lede">{lede}</p>}

			<slot />

			<SiteFooterNav lang={lang} currentPath={path} />
		</div>
		<SimpleThemeWrapper client:only="react" />
		<!-- 埋め込んだ画面は押すまで触れない（ui/atoms/mapEmbed.ts） -->
		<script is:inline set:html={MAP_EMBED_SCRIPT}></script>
	</body>
</html>
