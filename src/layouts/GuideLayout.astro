---
/**
 * 検索流入向けガイドページ（/guides/*, /en/guides/*）の共通レイアウト。
 *
 * 固定ページ（StaticPage.astro）は「1つのURLの中で日本語/英語をJSで
 * 切り替える」方式だが、このガイド群は言語ごとに別URL（/guides/xxx と
 * /en/guides/xxx）にする（ユーザー指定のURL設計）。そのためStaticPage.astro
 * はそのまま使わず、同じデザイントークン・同じ`staticPageCss`を土台に
 * ガイド用の追加スタイル（guideCss）を足した専用レイアウトにしている。
 *
 * 構成: パンくず → H1 → 検索意図への直接回答 → CTA（地図を開く）→
 * 補足セクション → 関連ガイド → フッター。CTAを本文の早い位置に置き、
 * 巨大な装飾で地図への導線を下に追いやらないようにする（モバイル想定）。
 */
import { staticPageCss } from './staticPageStyles';
import { guideCss } from './guideStyles';
import SimpleThemeWrapper from '../components/SimpleThemeWrapper.tsx';
import MapOpenCta from '../components/MapOpenCta.astro';
import { SITE_URL, SITE_NAME, GOOGLE_SITE_VERIFICATION } from '../config/seo';
import type { GuideDefinition } from '../data/guides';

export interface Props {
  guide: GuideDefinition;
  /** パンくず「ガイド一覧」への戻り先 */
  indexHref: string;
  indexLabel: string;
  /** 「トップに戻る」リンクの文言 */
  backLabel: string;
}

const { guide, indexHref, indexLabel, backLabel } = Astro.props;
const path = `/${guide.lang === 'en' ? 'en/guides' : 'guides'}/${guide.slug}`;
const canonical = `${SITE_URL}${path}`;
const htmlLang = guide.lang;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: SITE_NAME, item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: indexLabel, item: `${SITE_URL}${indexHref}` },
    { '@type': 'ListItem', position: 3, name: guide.breadcrumbLabel, item: canonical },
  ],
};

const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: guide.title,
  description: guide.description,
  url: canonical,
  inLanguage: guide.lang,
  isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: `${SITE_URL}/` },
};
---

<html lang={htmlLang}>
	<head>
		<meta charset="utf-8" />
		{GOOGLE_SITE_VERIFICATION && (
			<meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
		)}
		<link rel="icon" type="image/png" sizes="32x32" href="/icon_flex_rail_way_map.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/icon_flex_rail_way_map.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/icon_flex_rail_way_map.png" />
		<link rel="shortcut icon" href="/icon_flex_rail_way_map.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<title>{guide.title}</title>
		<meta name="description" content={guide.description} />
		{guide.keywords && <meta name="keywords" content={guide.keywords} />}
		<meta name="robots" content="index, follow" />

		<link rel="canonical" href={canonical} />
		{/* このガイドに対応する翻訳版が無いため、自己参照のみ（無理な対訳付けはしない） */}
		<link rel="alternate" hreflang={htmlLang} href={canonical} />
		<link rel="alternate" hreflang="x-default" href={canonical} />

		<meta property="og:type" content="article" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={guide.title} />
		<meta property="og:description" content={guide.description} />
		<meta property="og:image" content={`${SITE_URL}/icon_flex_rail_way_map.png`} />
		<meta property="og:locale" content={guide.lang === 'en' ? 'en_US' : 'ja_JP'} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={guide.title} />
		<meta name="twitter:description" content={guide.description} />

		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} />

		<style set:html={staticPageCss}></style>
		<style set:html={guideCss}></style>
	</head>
	<body>
		<script is:inline>
			// ハイドレーション前にテーマclassを確定させ、白背景のちらつきを防ぐ
			(function () {
				try {
					var saved = localStorage.getItem('theme');
					document.body.className = saved === 'light' || saved === 'dark' ? saved : 'dark';
				} catch (e) { document.body.className = 'dark'; }
			})();
		</script>
		<div class="container">
			<nav class="breadcrumb">
				<a href="/">{SITE_NAME}</a> / <a href={indexHref}>{indexLabel}</a> / {guide.breadcrumbLabel}
			</nav>

			<a href="/" class="back-link" style="margin-bottom: 24px;">{backLabel}</a>

			<h1 class="page-title">{guide.h1}</h1>
			<p class="lede">{guide.searchIntentAnswer}</p>

			<MapOpenCta
				label={guide.ctaLabel}
				note={guide.ctaNote}
				guideSlug={guide.slug}
				language={guide.lang}
				routes={guide.ctaRoutes}
			/>

			{guide.sections.map(section => (
				<section>
					<h2>{section.heading}</h2>
					{section.paragraphs.map(p => <p>{p}</p>)}
				</section>
			))}

			{guide.related.length > 0 && (
				<section>
					<h2>{guide.lang === 'en' ? 'Related Guides' : '関連ガイド'}</h2>
					<ul class="related-list">
						{guide.related.map(r => (
							<li><a href={r.href}>{r.label}</a></li>
						))}
					</ul>
				</section>
			)}
		</div>

		<SimpleThemeWrapper client:only="react" />
	</body>
</html>
