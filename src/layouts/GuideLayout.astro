---
/**
 * 検索流入向けガイドページ（/guides/*, /en/guides/*）の共通レイアウト。
 *
 * 固定ページ（StaticPage.astro）は「1つのURLの中で日本語/英語をJSで
 * 切り替える」方式だが、このガイド群は言語ごとに別URL（/guides/xxx と
 * /en/guides/xxx）にする（ユーザー指定のURL設計）。そのためStaticPage.astro
 * はそのまま使わず、同じデザイントークン・同じ`staticPageCss`を土台に
 * ガイド用の追加スタイル（guideCss）を足した専用レイアウトにしている。
 *
 * 構成: パンくず → H1 → 検索意図への直接回答 → CTA（地図を開く）→
 * 補足セクション → 関連ガイド → フッター。CTAを本文の早い位置に置き、
 * 巨大な装飾で地図への導線を下に追いやらないようにする（モバイル想定）。
 */
import { staticPageCss } from './staticPageStyles';
import { guideCss } from './guideStyles';
import { seoPageCss } from './seoPageStyles';
import SimpleThemeWrapper from '../components/SimpleThemeWrapper.tsx';
import MapOpenCta from '../components/MapOpenCta.astro';
import SeoHead from '../components/seo/SeoHead.astro';
import ThemeInitScript from '../components/ThemeInitScript.astro';
import SiteFooterNav from '../components/SiteFooterNav.astro';
import LineChip from '../components/seo/LineChip.astro';
import { lineByKey, SEO_LANGS, type SeoLang } from '../seo/pageModel';
import { SEO_TEXT } from '../seo/pageText';
import { SITE_NAME, buildHreflangLinks, buildBreadcrumbJsonLd, canonicalUrl, hreflangCode } from '../config/seo';
import { guidePath, getGuideTranslations, type GuideDefinition } from '../data/guides';

export interface Props {
  guide: GuideDefinition;
  /** パンくず「ガイド一覧」への戻り先 */
  indexHref: string;
  indexLabel: string;
  /** 「トップに戻る」リンクの文言 */
  backLabel: string;
}

const { guide, indexHref, indexLabel, backLabel } = Astro.props;
const path = guidePath(guide);
const canonical = canonicalUrl(path);
// 同じ slug の各言語版どうしを hreflang で結ぶ（翻訳が無いガイドは出さない）。
// x-default は日本語版、無ければ英語版
const hreflangLinks = buildHreflangLinks(
  getGuideTranslations(guide).map(g => ({ lang: g.lang, path: guidePath(g) })),
  getGuideTranslations(guide).some(g => g.lang === 'ja') ? 'ja' : 'en',
);
const htmlLang = guide.lang;
// ガイドが地図で開く路線のうち、路線ページがあるもの（駅・路線ページと相互にリンクする）
const seoLang = (SEO_LANGS as string[]).includes(guide.lang) ? (guide.lang as SeoLang) : undefined;
const guideLines = seoLang ? (guide.ctaRoutes ?? []).filter(r => lineByKey(r)) : [];
const RELATED_HEADING: Record<GuideDefinition['lang'], string> = {
  ja: '関連ガイド',
  en: 'Related Guides',
  zh: '相关指南',
  ko: '관련 가이드',
};
const FAQ_HEADING: Record<GuideDefinition['lang'], string> = {
  ja: 'よくある質問',
  en: 'Frequently Asked Questions',
  zh: '常见问题',
  ko: '자주 묻는 질문',
};

// FAQPage構造化データは、ページ上に実際に表示するFAQ（下のsection）と
// 完全に一致させる（見えているFAQと違う内容を構造化データにだけ書かない）。
const faqJsonLd = guide.faq && guide.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.faq.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : null;

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: SITE_NAME, path: '/' },
  { name: indexLabel, path: indexHref },
  { name: guide.breadcrumbLabel, path },
]);

const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: guide.title,
  description: guide.description,
  url: canonical,
  inLanguage: guide.lang,
  isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: canonicalUrl('/') },
};
---

<html lang={hreflangCode(htmlLang)}>
	<head>
		<SeoHead
			title={guide.title}
			description={guide.description}
			path={path}
			lang={guide.lang}
			hreflang={hreflangLinks}
			ogType="article"
			keywords={guide.keywords}
			jsonLd={[breadcrumbJsonLd, webPageJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])]}
			styles={[staticPageCss, guideCss, seoPageCss]}
		/>
	</head>
	<body>
		<ThemeInitScript />
		<div class="container">
			<nav class="breadcrumb">
				<a href="/">{SITE_NAME}</a> / <a href={indexHref}>{indexLabel}</a> / {guide.breadcrumbLabel}
			</nav>

			<a href="/" class="back-link" style="margin-bottom: 24px;">{backLabel}</a>

			<h1 class="page-title">{guide.h1}</h1>
			<p class="lede">{guide.searchIntentAnswer}</p>

			<MapOpenCta
				label={guide.ctaLabel}
				note={guide.ctaNote}
				kind="guide"
				guideSlug={guide.slug}
				city={guide.city}
				language={guide.lang}
				routes={guide.ctaRoutes}
			/>

			{/*
				「実際のMap Preview / Screenshot / Visual」枠。CTAより前に置くと
				モバイルでCTAがファーストビューから押し出されてしまうため
				（CTAは意図的に早い位置に固定してある、上のコメント参照）、
				あえてCTAの直後に置いている。各ガイドページ側で
				<Fragment slot="visual"> を渡した場合だけ表示される。
			*/}
			<slot name="visual" />

			{guide.sections.map(section => (
				<section>
					<h2>{section.heading}</h2>
					{section.paragraphs.map(p => <p>{p}</p>)}
					{section.cta && (
						<MapOpenCta
							label={section.cta.label}
							kind="guide"
							guideSlug={guide.slug}
							city={guide.city}
							language={guide.lang}
							routes={section.cta.routes}
						/>
					)}
				</section>
			))}

			{/* 記事末尾にも同じCTAをもう一度置く（ファーストビュー付近だけでなく、
			   本文を読んだ後にも迷わず地図へ行けるように） */}
			<MapOpenCta
				label={guide.ctaLabel}
				note={guide.ctaNote}
				kind="guide"
				guideSlug={guide.slug}
				city={guide.city}
				language={guide.lang}
				routes={guide.ctaRoutes}
			/>

			{guide.faq && guide.faq.length > 0 && (
				<section>
					<h2>{FAQ_HEADING[guide.lang]}</h2>
					<dl class="faq-list">
						{guide.faq.map(item => (
							<div class="faq-item">
								<dt class="faq-question">{item.question}</dt>
								<dd class="faq-answer">{item.answer}</dd>
							</div>
						))}
					</dl>
				</section>
			)}

			{seoLang && guideLines.length > 0 && (
				<section>
					<h2>{SEO_TEXT[seoLang].lineDetails}</h2>
					<ul class="seo-chips">{guideLines.map(r => <LineChip route={r} lang={seoLang} />)}</ul>
				</section>
			)}

			{guide.related.length > 0 && (
				<section>
					<h2>{RELATED_HEADING[guide.lang]}</h2>
					<ul class="related-list">
						{guide.related.map(r => (
							<li><a href={r.href}>{r.label}</a></li>
						))}
					</ul>
				</section>
			)}
			<SiteFooterNav lang={guide.lang} currentPath={path} />
		</div>

		<SimpleThemeWrapper client:only="react" />
	</body>
</html>
