---
/**
 * 固定ページ（about / contact / faq / privacy / terms）の骨組み。
 *
 * この5ページは <head> のボイラープレート・スタイル・言語切替スクリプトを
 * 丸ごとコピーして持っていた。同一のはずが実際には食い違っていて、
 * hreflang のドメインが3ページだけ存在しない `flex-rail-map.netlify.app`
 * を指したままになっていた（正しくは flex-railway-map）。
 *
 * ページ側には中身だけを書く。日本語版を `<div id={`${langPrefix}-ja`}>`、
 * 英語版を `-en` で囲むと、?lang= に応じてどちらかが表示される。
 */
import SimpleThemeWrapper from '../components/SimpleThemeWrapper.tsx';
import { THEME_STORAGE_KEY, LEGACY_THEME_STORAGE_KEY } from '../utils/themeStorage';
import SiteFooterNav from '../components/SiteFooterNav.astro';
import { staticPageCss } from './staticPageStyles';
import { SITE_URL, GOOGLE_SITE_VERIFICATION } from '../config/seo';
import FaviconLinks from '../components/seo/FaviconLinks.astro';

interface Props {
  /** <title> にそのまま入る */
  title: string;
  /** meta description */
  description: string;
  /** meta keywords（無いページは省略してよい） */
  keywords?: string;
  /** このページのパス（"/about" など）。canonical に使う */
  path: string;
  /**
   * ページの見出し（H1）。日本語・英語の本文ブロックそれぞれに見出しを書くと、
   * 片方を非表示にしていても HTML 上は2つになり、以前は各ページ h2 始まりで
   * H1 が1つも無かった。ここで1つだけ出し、言語切替で文言だけ差し替える。
   */
  heading: { ja: string; en: string };
  /** 言語切替する要素のid接頭辞。"about" なら about-ja / about-en を切り替える */
  langPrefix: string;
  /** <html lang>。既定は日本語 */
  htmlLang?: string;
  /** 戻るリンクの文言 */
  backLabel?: string;
}

const {
  title,
  description,
  keywords,
  path,
  heading,
  langPrefix,
  htmlLang = 'ja',
  backLabel = '← 路線図に戻る / Back to Map',
} = Astro.props;
---

<html lang={htmlLang}>
	<head>
		<meta charset="utf-8" />
		{GOOGLE_SITE_VERIFICATION && (
			<meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
		)}
		<meta name="google-adsense-account" content="ca-pub-2444529114040977" />
		<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2444529114040977" crossorigin="anonymous"></script>
		<FaviconLinks />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		{keywords && <meta name="keywords" content={keywords} />}
		<meta name="robots" content="index, follow" />

		<link rel="canonical" href={`${SITE_URL}${path}`} />
		{/*
			hreflang は出さない。このページの英語版は ?lang=en で同じHTMLを
			JSで切り替えているだけで、canonical はクエリなしのこのURLを指す。
			canonical が別URLのページを hreflang の相手にすると検索エンジンは
			矛盾として無視するため、以前の ?lang=ja/en の hreflang は効いていなかった。
			別URLの英語版を作るまでは付けない（buildHreflangLinks 参照）。
		*/}

		<slot name="head" />

		<style set:html={staticPageCss}></style>
	</head>
	<body>
		<div class="container">
			<a href="/" class="back-link">{backLabel}</a>
			<h1 class="page-title" id="static-page-h1" data-ja={heading.ja} data-en={heading.en}>{heading.ja}</h1>
			<slot />
			<SiteFooterNav currentPath={path} />
		</div>

		<script is:inline define:vars={{ langPrefix, themeKey: THEME_STORAGE_KEY, legacyThemeKey: LEGACY_THEME_STORAGE_KEY }}>
			// ?lang=en なら英語版の塊だけを出す。既定は日本語
			function switchLanguage() {
				const lang = new URLSearchParams(window.location.search).get('lang') || 'ja';
				const ja = document.getElementById(langPrefix + '-ja');
				const en = document.getElementById(langPrefix + '-en');
				const h1 = document.getElementById('static-page-h1');
				if (h1) h1.textContent = lang === 'en' ? h1.dataset.en : h1.dataset.ja;
				if (!ja || !en) return;
				ja.style.display = lang === 'en' ? 'none' : 'block';
				en.style.display = lang === 'en' ? 'block' : 'none';
			}

			// 地図側と同じ localStorage のテーマに合わせる（保存先は utils/themeStorage.ts）
			function applyTheme() {
				document.body.className = localStorage.getItem(themeKey) || localStorage.getItem(legacyThemeKey) || 'light';
			}

			document.addEventListener('DOMContentLoaded', () => {
				switchLanguage();
				applyTheme();
			});
		</script>

		<SimpleThemeWrapper client:only="react" />
	</body>
</html>
