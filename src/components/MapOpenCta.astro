---
/**
 * 「Flex Railway Mapで見る」CTA（ガイド・駅・路線・データのページ共通）。
 *
 * ページの内容に対応した地図状態（表示路線・出発駅）を直接開く。
 * URLの組み立ては src/utils/mapDeepLink.ts（地図側が読むパラメータと同じ定数）。
 *
 * クリックはGA4の `seo_map_open` イベントとして計測する
 * （`src/utils/gtagConsent.ts` の既存の仕組みを再利用。GA4未設定でも
 * エラーにはならない）。どのSEOページから地図へ移動したかを判別できるよう
 * `guide_slug`（ガイドの slug、駅・路線ページでは "station/shinjuku" など）/
 * `language` に加えて `source_page`（クリック時点の location.pathname）も送る。
 * 個人を特定する情報ではなく、このサイト内のパスのみ。
 */
import { buildMapHref } from '../utils/mapDeepLink';
import type { RouteKey } from '../data/routes';

export interface Props {
  label: string;
  note?: string;
  guideSlug: string;
  language: 'ja' | 'en' | 'zh' | 'ko';
  /** 地図で先に表示しておきたい路線 */
  routes?: RouteKey[];
  /** 出発駅にする駅名 */
  from?: string;
}

const { label, note, guideSlug, language, routes, from } = Astro.props;
const href = buildMapHref({ routes, from, lang: language });
---

<div class="cta-block">
  <a
    href={href}
    class="back-link"
    data-seo-map-open
    data-guide-slug={guideSlug}
    data-guide-lang={language}
  >
    {label}
  </a>
  {note && <p class="cta-note">{note}</p>}
</div>

<script>
  import { trackEvent } from '../utils/gtagConsent';

  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement)?.closest<HTMLElement>('[data-seo-map-open]');
    if (!target) return;
    trackEvent('seo_map_open', {
      guide_slug: target.getAttribute('data-guide-slug') ?? '',
      language: target.getAttribute('data-guide-lang') ?? '',
      source_page: window.location.pathname,
    });
  });
</script>
