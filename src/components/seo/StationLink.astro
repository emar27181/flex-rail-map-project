---
/** 駅名。その言語の駅ページがある駅はリンクにする */
import { hasStationPage, stationPath, stationName, type SeoLang, type StationRefLink } from '../../seo/pageModel';

interface Props {
  station: StationRefLink;
  lang: SeoLang;
}

const { station, lang } = Astro.props;
const name = stationName(station, lang);
---

{hasStationPage(station, lang) ? <a href={stationPath(station.slug!, lang)}>{name}</a> : <span>{name}</span>}
