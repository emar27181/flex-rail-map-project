---
/**
 * 記事ページ・記事一覧の共通レイアウト（日本語・英語・中国語〈簡体字〉・韓国語）。
 *
 * 言語ごとに別URL（/articles/{slug}, /en/articles/{slug}, /zh/..., /ko/...）で書き出す。
 * 以前は1つのURLの中で本文をJSで差し替えていたため、検索エンジンには日本語版しか
 * 見えず、英語・中国語・韓国語で検索した人に記事が出なかった。
 *
 * - <html lang>・canonical（自分自身）・hreflang（4言語＋x-default）・og:locale・
 *   構造化データの inLanguage を、その言語で出す
 * - 見出し・本文・外枠の文言は articleI18n.ts / articleBodyI18n.ts から、ビルド時に
 *   その言語のものだけを入れる
 * - 言語の切り替えは右上の LanguageSwitcher（各言語版へのリンク）
 */
import { existingMapPreview, MAP_PREVIEW } from '../../seo/mapPreview';
import ArticleThumbnail from './ArticleThumbnail.astro';
import "../../styles/article-layout.css";
import {
  ARTICLES,
  ARTICLE_LANGUAGES,
  ARTICLE_PAGE_KEYWORDS,
  ARTICLE_PAGE_TRANSLATIONS,
  ARTICLE_SHELL_TRANSLATIONS,
  type ArticleLanguage,
} from "../../data/articleI18n";
import { ARTICLE_BODY_TRANSLATIONS } from "../../data/articleBodyI18n";
import { APP_ICON_PATH, GOOGLE_SITE_VERIFICATION, SITE_URL, SITE_NAME, OG_LOCALE, buildHreflangLinks, hreflangCode, withSiteName } from "../../config/seo";
import FaviconLinks from "../seo/FaviconLinks.astro";
import GA4Loader from "../GA4Loader.astro";
import { ADSENSE_CLIENT, ADSENSE_SCRIPT_SRC } from "../../config/ads";
import { CONTROL_CSS, HEADER_LOGO_PX } from "../ui/atoms/controlCss";
import { RESPONSIVE_TABLE_CSS } from "../ui/atoms/responsiveTable";
import { ARTICLE_SOURCES } from "../../data/articles";
import { articleToc } from "../../utils/articleRender";
import { AD_SLOT_CSS, AD_SLOT_SCRIPT } from "../ui/atoms/adSlot";
import { findArticleStation } from "../../utils/articleFacts";
import { getSeoModel, hasStationPage, lineByKey, linePath, routeName, stationName, stationPath } from "../../seo/pageModel";

import { MAP_EMBED_CSS, MAP_EMBED_SCRIPT, withFirstEmbedPoster } from "../ui/atoms/mapEmbed";
import { THEME_STORAGE_KEY, LEGACY_THEME_STORAGE_KEY } from "../../utils/themeStorage";
import { L } from "../legend/legendStyles";
import SiteFooterNav from "../SiteFooterNav.astro";
import LanguageSwitcher from "../LanguageSwitcher.astro";
import LanguageSuggestion from "../LanguageSuggestion.astro";
import {
  articleBreadcrumbJsonLd, articleIndexPath, articleJsonLd, articlePath,
} from "../../config/articleSeo";

export interface Props {
  lang: ArticleLanguage;
  /** 記事の slug。記事一覧は "articles" */
  pageKey: string;
  publishedDate?: string;
  modifiedDate?: string;
  ogImage?: string;
  kind?: "article" | "index";
  themeColor?: string;
}

const {
  lang,
  pageKey,
  publishedDate = "2025-06-06",
  modifiedDate,
  ogImage = APP_ICON_PATH,
  kind = "article",
  themeColor = "#13171A",
} = Astro.props;

const isArticle = kind === "article";
// 文章中の {siteName} は正式なサービス名（src/config/seo.ts）に置き換える
const shell = withSiteName(ARTICLE_SHELL_TRANSLATIONS[lang]);
const meta = withSiteName(ARTICLE_PAGE_TRANSLATIONS[pageKey][lang]);
const rawBody = withSiteName(ARTICLE_BODY_TRANSLATIONS[pageKey]?.[lang]);
// 日本語のキーワードだけ用意してある（他の言語は meta keywords を出さない）
const keywords = lang === "ja" ? withSiteName(ARTICLE_PAGE_KEYWORDS[pageKey]) : undefined;
const pathOf = (l: ArticleLanguage) => (isArticle ? articlePath(pageKey, l) : articleIndexPath(l));
const path = pathOf(lang);
const canonicalUrl = `${SITE_URL}${path}`;
// 記事冒頭の地図の実際の画面（src/seo/mapPreview.ts）。無い記事はアプリのアイコン
const preview = existingMapPreview(path);
// 冒頭の地図の埋め込みには、読み込むまで同じ画面の画像を敷く
const body = rawBody && withFirstEmbedPoster(rawBody, preview);
const versions = Object.fromEntries(ARTICLE_LANGUAGES.map(l => [l, pathOf(l)]));
const hreflang = buildHreflangLinks(ARTICLE_LANGUAGES.map(l => ({ lang: l, path: pathOf(l) })), "ja");
const LOCALE: Record<ArticleLanguage, string> = { ja: "ja-JP", en: "en-US", zh: "zh-CN", ko: "ko-KR" };
const formatDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString(LOCALE[lang], { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const UPDATED: Record<ArticleLanguage, string> = { ja: "更新", en: "Updated", zh: "更新", ko: "수정" };
const home = lang === "ja" ? "/" : `/?lang=${lang}`;
const indexCrumb = { name: shell.articles, path: articleIndexPath(lang) };
// 記事データ（目次・出典・関連する路線と駅）
const source = isArticle ? ARTICLE_SOURCES.find(a => a.slug === pageKey) : undefined;
const toc = source ? articleToc(source, lang).map(t => ({ ...t, text: withSiteName(t.text) })) : [];
const sources = source?.sources ?? [];
// 関連する路線・駅は、その言語のページがあるものはリンク、無いものは名前だけ
const relatedLines = (source?.relatedRoutes ?? []).map(key => {
  const line = lineByKey(key);
  return { name: routeName(key, lang), href: line ? linePath(line.slug, lang) : undefined };
});
const relatedStations = (source?.relatedStations ?? []).map(ref => {
  const st = findArticleStation(ref);
  const page = st && getSeoModel().stations.find(s => s.name === ref.name && s.routes.includes(ref.route));
  return {
    name: page ? stationName(page, lang) : ref.name,
    href: page && hasStationPage(page, lang) ? stationPath(page.slug, lang) : undefined,
  };
});
// 関連記事（1記事1テーマにしているので、ほかのテーマはここから案内する）
const related = (isArticle ? ARTICLES.find(a => a.slug === pageKey)?.related ?? [] : [])
  .map(slug => ({ slug, meta: withSiteName(ARTICLE_PAGE_TRANSLATIONS[slug][lang]) }));
---

<!DOCTYPE html>
<html lang={hreflangCode(lang)} data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{meta.title} | {SITE_NAME}</title>
  <meta name="description" content={meta.description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content={themeColor} />
  <link rel="canonical" href={canonicalUrl} />
  {hreflang.map(h => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)}

  <meta property="og:title" content={meta.title} />
  <meta property="og:description" content={meta.description} />
  <meta property="og:type" content={isArticle ? "article" : "website"} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={`${SITE_URL}${preview ?? ogImage}`} />
  {preview && <meta property="og:image:width" content={String(MAP_PREVIEW.width)} />}
  {preview && <meta property="og:image:height" content={String(MAP_PREVIEW.height)} />}
  {preview && <meta property="og:image:alt" content={meta.title} />}
  <meta property="og:locale" content={OG_LOCALE[lang]} />
  {ARTICLE_LANGUAGES.filter(l => l !== lang).map(l => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
  <meta name="twitter:card" content={preview ? "summary_large_image" : "summary"} />
  {preview && <meta name="twitter:image" content={`${SITE_URL}${preview}`} />}

  {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
  <meta name="google-adsense-account" content={ADSENSE_CLIENT} />
  <script async src={ADSENSE_SCRIPT_SRC} crossorigin="anonymous"></script>

  <FaviconLinks />
  <GA4Loader consentBanner />
  <link rel="manifest" href="/manifest.json" />
  <style set:html={CONTROL_CSS + RESPONSIVE_TABLE_CSS + MAP_EMBED_CSS + AD_SLOT_CSS}></style>
  <script is:inline define:vars={{ themeKey: THEME_STORAGE_KEY, legacyThemeKey: LEGACY_THEME_STORAGE_KEY }}>
    // 地図・ほかのページと同じ保存先のテーマ（utils/themeStorage.ts）
    (function(){
      try {
        var saved = localStorage.getItem(themeKey) || localStorage.getItem(legacyThemeKey);
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch (e) {}
    })();
  </script>

  {isArticle && <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd({ title: meta.title, description: meta.description, keywords, publishedDate, modifiedDate, canonicalUrl, ogImage, image: preview, lang }))}></script>}
  <script type="application/ld+json" set:html={JSON.stringify(articleBreadcrumbJsonLd(isArticle ? { title: meta.title, canonicalUrl } : undefined, indexCrumb))}></script>

  {lang === "ja" && (
    <script is:inline>
      // 旧URL（/articles/...?lang=en など、JSで本文を差し替えていた頃）で来たら、その言語の
      // URLへ移る。サーバー側の転送（netlify.toml）が効かない環境でも同じ結果にするための保険
      (function(){
        var m = /[?&]lang=(en|zh|ko)(?:&|$)/.exec(window.location.search);
        if (m) window.location.replace('/' + m[1] + window.location.pathname + window.location.hash);
      })();
    </script>
  )}
  <slot name="head" />
</head>
<body>
  <div class="masthead">
    <div class="row">
      <a href={home} class="brand"><img class="brand-logo" src={APP_ICON_PATH} width={HEADER_LOGO_PX} height={HEADER_LOGO_PX} alt="" style={`border-radius: ${L.r.control}`} /><span class="brand-name">{shell.brand}</span></a>
      <div class="mh-actions">
        <span class="tagpill">{meta.tag}</span>
        <LanguageSwitcher current={lang} versions={versions} />
        <button class="ctl ctl-icon theme-btn" id="themeBtn" aria-label={shell.switchTheme} title={shell.switchTheme}>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="wrap">
    <LanguageSuggestion current={lang} versions={versions} />
    <nav class="crumb"><a href={home}>{shell.top}</a> ／ <a href={articleIndexPath(lang)}>{shell.articles}</a></nav>
    <header class="post">
      <span class="kicker">{meta.kicker}</span>
      <h1>{meta.title}</h1>
      <p class="lede">{meta.description}</p>
      <div class="byline">
        <span>{formatDate(publishedDate)}</span>{modifiedDate && <time datetime={modifiedDate}>（{UPDATED[lang]}: {formatDate(modifiedDate)}）</time>}<span class="sep">／</span><span>{meta.category}</span><span class="sep">／</span><span>{meta.readTime}</span>
      </div>
    </header>
    <slot name="beforeArticle" />
    {toc.length > 0 && (
      // 目次は閉じて置く（記事は「結論 → まず地図に触る」の順。目次で冒頭のデモを下へ押し出さない）
      <nav class="toc" aria-label={shell.toc}>
        <details>
          <summary>{shell.toc}</summary>
          <ol>{toc.map(t => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
        </details>
      </nav>
    )}
    <article>
      {body && <div class="article-body" set:html={body} />}
      <slot />
    </article>
    {(relatedLines.length > 0 || relatedStations.length > 0) && (
      <section class="places" aria-labelledby="places-heading">
        <h2 id="places-heading">{shell.relatedPlaces}</h2>
        <ul class="place-list">
          {[...relatedLines, ...relatedStations].map(p => <li>{p.href ? <a href={p.href}>{p.name}</a> : p.name}</li>)}
        </ul>
      </section>
    )}
    {sources.length > 0 && (
      <section class="sources" aria-labelledby="sources-heading">
        <h2 id="sources-heading">{shell.sources}</h2>
        <ul>
          {sources.map(src => (
            <li><a href={src.url} rel="noopener" target="_blank">{src.title}</a> <span class="meta">{src.publisher} · {shell.checkedAt} <time datetime={src.checkedAt}>{formatDate(src.checkedAt)}</time></span></li>
          ))}
        </ul>
      </section>
    )}
    {related.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <h2 id="related-heading">{shell.relatedArticles}</h2>
        <ul class="article-list">
          {related.map(r => (
            <li>
              <a href={articlePath(r.slug, lang)}>
                <ArticleThumbnail slug={r.slug} lang={lang} title={r.meta.title} />
                <span class="article-card-title">{r.meta.title}</span>
                <span class="meta">{r.meta.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <div class="foot">
      <a href={home}>{shell.top}</a> ／ <a href={articleIndexPath(lang)}>{shell.articlesBack}</a>
      <div><a href={home} class="foot-app-link">{shell.openApp}</a></div>
      <div class="small">{shell.footerCopy}</div>
      <SiteFooterNav lang={lang} currentPath={path} />
    </div>
  </div>

  <script is:inline define:vars={{ themeKey: THEME_STORAGE_KEY }}>
    (function(){
      var root = document.documentElement;
      var btn = document.getElementById('themeBtn');
      if (!btn) return;
      btn.addEventListener('click', function(){
        var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem(themeKey, next); } catch (e) {}
      });
    })();
  </script>
  <!-- 埋め込んだ画面は押すまで触れない（ui/atoms/mapEmbed.ts） -->
  <script is:inline set:html={MAP_EMBED_SCRIPT}></script>
  <!-- 広告は本番のサイトだけ。ほかでは位置だけ見せる（ui/atoms/adSlot.ts） -->
  <script is:inline set:html={AD_SLOT_SCRIPT}></script>
  {isArticle && (
    <script is:inline type="application/json" id="article-context" set:html={JSON.stringify({ article: pageKey, locale: lang })}></script>
  )}
  <script>
    // 記事の中の操作（デモを見た・触った・地図へ移った・関連記事）を GA4 に送る（utils/articleAnalytics.ts）
    import { initArticleAnalytics } from "../../utils/articleAnalytics";
    const el = document.getElementById("article-context");
    if (el) initArticleAnalytics(JSON.parse(el.textContent || "{}"));
  </script>
  <slot name="scripts" />
</body>
</html>
