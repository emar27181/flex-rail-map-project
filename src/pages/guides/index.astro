---
import GuidesIndexLayout from "../../layouts/GuidesIndexLayout.astro";
import { getGuidesByLang } from "../../data/guides";

const jaGuides = getGuidesByLang('ja');
---

<GuidesIndexLayout
	title="ガイド一覧 - Flex Railway Map | 東京の路線図・鉄道の見方"
	description="Flex Railway Mapのガイド一覧です。東京の路線図をシンプルに見る方法など、目的別のガイドから、そのままインタラクティブ路線図を開けます。"
	path="/guides"
	htmlLang="ja"
	backLabel="← Flex Railway Map トップへ"
>
	<h1 class="page-title">ガイド一覧</h1>
	<p class="lede">
	目的別のガイドです。各ガイドから、その内容に対応したFlex Railway Mapの地図をそのまま開けます。
	</p>
	<ul class="related-list">
		{jaGuides.map(g => (
			<li><a href={`/guides/${g.slug}`}>{g.breadcrumbLabel}</a></li>
		))}
		<li><a href="/articles/tokyo-train-map-beginner">東京の路線図の読み方・乗り換え方【完全初心者ガイド】</a></li>
		<li><a href="/articles/flex-rail-map-introduction">Flex Railway Mapを作っている理由</a></li>
	</ul>
	<h2>アプリの使い方そのものを知りたい方へ</h2>
	<p>
	路線の表示切替・経路検索など、Flex Railway Map自体の操作方法は<a href="/guide">使い方ガイド</a>をご覧ください。
	</p>
	<h2>English</h2>
	<p>
	<a href="/en/guides">English guides</a> are also available.
	</p>
</GuidesIndexLayout>
