---
/**
 * 路線ページ（/lines/{slug}, /en/lines/{slug}）。
 * 駅一覧・乗換駅・直通運転・駅周辺データへのリンクを路線データから作る。
 */
import SeoPageLayout from '../../../layouts/SeoPageLayout.astro';
import MapOpenCta from '../../../components/MapOpenCta.astro';
import LineChip from '../../../components/seo/LineChip.astro';
import ResponsiveTable from '../../../components/ui/atoms/ResponsiveTable.astro';
import TableCell from '../../../components/ui/atoms/TableCell.astro';
import type { TableColumn } from '../../../components/ui/atoms/responsiveTable';
import {
  DATA_LANGS, SEO_LANGS, dataPath, getSeoModel, guidesForRoutes, hasStationPage, hubPath, linePath, routeName,
  stationName, stationPath, type SeoLang, type SeoLine,
} from '../../../seo/pageModel';
import { SEO_TEXT, formatNumber, statLabel } from '../../../seo/pageText';

export function getStaticPaths() {
  return SEO_LANGS.flatMap(lang =>
    getSeoModel().lines.map(line => ({
      params: { lang: lang === 'ja' ? undefined : lang, slug: line.slug },
      props: { lang, line },
    })),
  );
}

interface Props { lang: SeoLang; line: SeoLine }
const { lang, line } = Astro.props;
const t = SEO_TEXT[lang];
const name = routeName(line.key, lang);
const path = linePath(line.slug, lang);
const first = stationName(line.stops[0].station, lang);
const last = stationName(line.stops[line.stops.length - 1].station, lang);
const transferCount = line.stops.filter(s => s.station.effectiveLines >= 2).length;
const relatedGuides = guidesForRoutes([line.key], lang);
// 駅一覧に添える駅周辺データ（データのページがある指標の先頭1つ。統計を集めている都市の路線だけ）
const dataPage = line.stops.some(s => s.station.stats.length > 0) ? getSeoModel().dataPages.find(d => d.indexable) : undefined;
const dataLabel = dataPage && statLabel(dataPage.meta.label, lang);
const dataHref = dataPage && DATA_LANGS.includes(lang) ? dataPath(dataPage.slug, lang) : undefined;
const lineCta = {
  label: t.openMapLine(name),
  kind: 'line' as const,
  guideSlug: `line/${line.slug}`,
  language: lang,
  routes: [line.key],
  city: line.city,
};

// 駅一覧の表の列（見せ方は ResponsiveTable の規格）
const cols = {
	no: { label: t.colNo, kind: 'index' },
	station: { label: t.colStation, kind: 'title' },
	transfers: { label: t.colTransfers, kind: 'text' },
	data: { label: dataLabel || '', kind: 'num', href: dataHref },
} satisfies Record<string, TableColumn>;
const columns: TableColumn[] = dataPage ? [cols.no, cols.station, cols.transfers, cols.data] : [cols.no, cols.station, cols.transfers];
---

<SeoPageLayout
	lang={lang}
	title={t.lineTitle(name, line.stops.length)}
	description={t.lineDescription(name, line.stops.length, first, last, transferCount)}
	path={path}
	langPaths={Object.fromEntries(SEO_LANGS.map(l => [l, linePath(line.slug, l)]))}
	breadcrumbs={[
		{ name: t.home, path: '/' },
		{ name: t.hubs.lines, path: hubPath('lines', lang) },
		{ name: name, path },
	]}
	h1={t.lineH1(name)}
	lede={t.lineLede(name, line.stops.length, first, last, transferCount)}
	indexable={line.indexable}
>
	<MapOpenCta {...lineCta} />

	<section>
		<h2>{t.stationList}</h2>
		<ResponsiveTable columns={columns}>
			{line.stops.map((stop, i) => {
				const stat = dataPage && stop.station.stats.find(s => s.key === dataPage.key);
				return (
					<tr>
						<TableCell col={cols.no}>{i + 1}</TableCell>
						<TableCell col={cols.station}>{hasStationPage(stop.station, lang)
							? <a href={stationPath(stop.station.slug, lang)}>{stationName(stop.station, lang)}</a>
							: stationName(stop.station, lang)}</TableCell>
						<TableCell col={cols.transfers}>{stop.transfers.map(r => routeName(r, lang)).join(t.listSep)}</TableCell>
						{dataPage && <TableCell col={cols.data}>{stat ? formatNumber(stat.value, lang) : '-'}</TableCell>}
					</tr>
				);
			})}
		</ResponsiveTable>
	</section>

	<MapOpenCta {...lineCta} />

	<section>
		<h2>{t.throughService}</h2>
		{line.throughPartners.length === 0
			? <p>{t.noThrough}</p>
			: line.throughPartners.map(p => (
				<Fragment>
					<p>{t.throughLine(p.map(r => routeName(r, lang)).join(t.listSep))}</p>
					<ul class="seo-chips">{p.map(r => <LineChip route={r} lang={lang} />)}</ul>
				</Fragment>
			))}
	</section>

	{relatedGuides.length > 0 && (
		<section>
			<h2>{t.relatedGuides}</h2>
			<ul class="related-list">
				{relatedGuides.map(g => <li><a href={g.path}>{g.title}</a></li>)}
			</ul>
		</section>
	)}
</SeoPageLayout>
