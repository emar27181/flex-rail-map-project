---
/** 路線の一覧（/lines, /en/lines）。都市ごとにまとめる */
import ResponsiveTable from '../../../components/ui/atoms/ResponsiveTable.astro';
import TableCell from '../../../components/ui/atoms/TableCell.astro';
import type { TableColumn } from '../../../components/ui/atoms/responsiveTable';
import SeoPageLayout from '../../../layouts/SeoPageLayout.astro';
import { SEO_LANGS, getSeoModel, hubPath, linePath, routeName, stationName, type SeoLang } from '../../../seo/pageModel';
import { SEO_TEXT } from '../../../seo/pageText';
import { SEO_CITIES } from '../../../data/seoPages';

export function getStaticPaths() {
  return SEO_LANGS.map(lang => ({ params: { lang: lang === 'ja' ? undefined : lang }, props: { lang } }));
}

interface Props { lang: SeoLang }
const { lang } = Astro.props;
const t = SEO_TEXT[lang];
const { lines } = getSeoModel();
const path = hubPath('lines', lang);

// 表の列（見せ方は ResponsiveTable の規格）
const lineCols = {
	line: { label: t.colLine, kind: 'title' },
	section: { label: t.colStation, kind: 'text' },
	count: { label: t.colCount, kind: 'num' },
} satisfies Record<string, TableColumn>;
---

<SeoPageLayout
	lang={lang}
	title={t.linesHubTitle}
	description={t.linesHubLede(lines.length)}
	path={path}
	langPaths={Object.fromEntries(SEO_LANGS.map(l => [l, hubPath('lines', l)]))}
	breadcrumbs={[{ name: t.home, path: '/' }, { name: t.hubs.lines, path }]}
	h1={t.linesHubH1}
	lede={t.linesHubLede(lines.length)}
	indexable={true}
>
	<nav aria-label={t.cities}>
		<ul class="seo-chips">
			{SEO_CITIES.map(city => <li class="seo-chip"><a href={`#${city.id}`}>{city.name[lang]}</a></li>)}
		</ul>
	</nav>

	{SEO_CITIES.map(city => (
		<section id={city.id}>
			<h2>{city.name[lang]}</h2>
			<ResponsiveTable columns={[lineCols.line, lineCols.section, lineCols.count]}>
				{lines.filter(l => l.city === city.id).map(line => (
					<tr>
						<TableCell col={lineCols.line}>
							{line.color && <span class="seo-swatch" style={`background-color: ${line.color}`} aria-hidden="true"></span>}{' '}
							<a href={linePath(line.slug, lang)}>{routeName(line.key, lang)}</a>
						</TableCell>
						<TableCell col={lineCols.section}>{t.section(stationName(line.stops[0].station, lang), stationName(line.stops[line.stops.length - 1].station, lang))}</TableCell>
						<TableCell col={lineCols.count}>{line.stops.length}</TableCell>
					</tr>
				))}
			</ResponsiveTable>
		</section>
	))}
</SeoPageLayout>
