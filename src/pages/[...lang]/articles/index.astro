---
/** 記事一覧の英語・中国語・韓国語版（/en/articles など）。日本語版は src/pages/articles/index.astro */
import ArticleLayout from "../../../components/articles/ArticleLayout.astro";
import { ARTICLES, ARTICLE_LANGUAGES, ARTICLE_PAGE_TRANSLATIONS, type ArticleLanguage } from "../../../data/articleI18n";
import { articlePath } from "../../../config/articleSeo";
import { withSiteName } from "../../../config/seo";

export function getStaticPaths() {
  return ARTICLE_LANGUAGES.filter(lang => lang !== "ja").map(lang => ({ params: { lang }, props: { lang } }));
}

interface Props { lang: ArticleLanguage }
const { lang } = Astro.props;
const LOCALE: Record<ArticleLanguage, string> = { ja: "ja-JP", en: "en-US", zh: "zh-CN", ko: "ko-KR" };
const month = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString(LOCALE[lang], { year: "numeric", month: "long", timeZone: "UTC" });
const meta = ARTICLE_PAGE_TRANSLATIONS.articles[lang];
---

<ArticleLayout lang={lang} pageKey="articles" kind="index">
  <section class="article-index" aria-label={meta.title}>
    <ul class="article-list">
      {ARTICLES.map(article => {
        const t = withSiteName(ARTICLE_PAGE_TRANSLATIONS[article.slug][lang]);
        return (
          <li>
            <a href={articlePath(article.slug, lang)}>
              <span class="article-card-title">{t.title}</span>
              <span class="meta">{month(article.publishedDate)} ｜ <span>{t.category}</span></span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</ArticleLayout>
