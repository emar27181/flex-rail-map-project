---
/**
 * 駅ページ（/stations/{slug}, /en/stations/{slug}）。
 * 中身はすべて src/seo/pageModel.ts が路線データ・駅統計・観光地データから作る。
 * Tier A だけ index、それ以外は noindex, follow（src/data/seoPages.ts の基準）。
 */
import ResponsiveTable from '../../../components/ui/atoms/ResponsiveTable.astro';
import TableCell from '../../../components/ui/atoms/TableCell.astro';
import type { TableColumn } from '../../../components/ui/atoms/responsiveTable';
import SeoPageLayout from '../../../layouts/SeoPageLayout.astro';
import MapOpenCta from '../../../components/MapOpenCta.astro';
import LineChip from '../../../components/seo/LineChip.astro';
import StationLink from '../../../components/seo/StationLink.astro';
import MapEmbed from '../../../components/ui/atoms/MapEmbed.astro';
import CodeBadge from '../../../components/ui/atoms/CodeBadge.astro';
import { buildMapHref } from '../../../utils/mapDeepLink';
import { getStationNumber } from '../../../data/stationNumbers';
import { routeColors } from '../../../data/routes';
import {
  DATA_LANGS, SEO_LANGS, dataPageFor, dataPath, getSeoModel, guidesForRoutes, hubPath, nearbyMajorStations,
  routeName, stationName, stationPath, type SeoLang, type SeoStation,
} from '../../../seo/pageModel';
import { SEO_TEXT, statLabel, statValue } from '../../../seo/pageText';

export function getStaticPaths() {
  return SEO_LANGS.flatMap(lang =>
    getSeoModel().stations.filter(station => station.langs.includes(lang)).map(station => ({
      params: { lang: lang === 'ja' ? undefined : lang, slug: station.slug },
      props: { lang, station },
    })),
  );
}

interface Props { lang: SeoLang; station: SeoStation }
const { lang, station } = Astro.props;
const t = SEO_TEXT[lang];
const name = stationName(station, lang);
const path = stationPath(station.slug, lang);
const lineNames = station.routes.map(r => routeName(r, lang));
const spotNames = station.touristSpots.map(spot => t.spotName(spot));
const nearby = nearbyMajorStations(station, lang);
const relatedGuides = guidesForRoutes(station.routes, lang);
// 地図を開くCTA（出発駅に指定できる駅は出発駅、できない駅は通る路線を表示して開く）
const stationCta = {
  label: station.mapFrom ? t.openMapFrom(name) : t.openMapRoutes(name),
  kind: 'station' as const,
  guideSlug: `station/${station.slug}`,
  language: lang,
  from: station.mapFrom,
  routes: station.mapFrom ? undefined : station.routes,
  station: station.name,
  city: station.cities[0],
};
const sources = [...new Map(station.stats.filter(s => s.source).map(s => [s.source!.title + s.source!.retrievedAt, s.source!])).values()];

// 表の列（見せ方は ResponsiveTable の規格）
const adjCols = {
	line: { label: t.colLine, kind: 'title' },
	prev: { label: t.prev, kind: 'text' },
	next: { label: t.next, kind: 'text' },
} satisfies Record<string, TableColumn>;
const statCols = {
	item: { label: t.colItem, kind: 'title' },
	value: { label: t.colValue, kind: 'num' },
	scope: { label: t.colScope, kind: 'note' },
} satisfies Record<string, TableColumn>;

// 冒頭のデモ: この駅を出発駅にした地図（出発駅にできない駅は通る路線を表示）。駅のまわりを開く
const STATION_EMBED_ZOOM = 13;
const embedSrc = buildMapHref({
	from: station.mapFrom,
	routes: station.mapFrom ? undefined : station.routes,
	center: [station.lat, station.lng],
	zoom: STATION_EMBED_ZOOM,
	lang,
	embed: true,
});
/** ページの差し色: この駅を通る最初の路線の色 */
const accent = station.routes.map(r => routeColors[r]).find(Boolean);
---

<SeoPageLayout
	lang={lang}
	title={t.stationTitle(name, station.effectiveLines, station.stats.length, spotNames)}
	description={t.stationDescription(name, lineNames, station.stats.length, spotNames)}
	path={path}
	langPaths={Object.fromEntries(station.langs.map(l => [l, stationPath(station.slug, l)]))}
	breadcrumbs={[
		{ name: t.home, path: '/' },
		{ name: t.hubs.stations, path: hubPath('stations', lang) },
		{ name: t.stationH1(name), path },
	]}
	h1={t.stationH1(name)}
	lede={t.stationLede(name, station.routes.length, station.effectiveLines)}
	indexable={station.indexable}
	accent={accent}
>
	<MapEmbed src={embedSrc} title={station.mapFrom ? t.embedStationTitle(name) : t.embedLineTitle(lineNames.join(t.listSep))} caption={t.embedCaption} />
	<MapOpenCta {...stationCta} />

	<section>
		<h2>{t.linesAtStation}</h2>
		<ul class="seo-chips">
			{station.routes.map(r => <LineChip route={r} lang={lang} />)}
		</ul>
		<MapOpenCta {...stationCta} label={t.openMapRoutes(name)} from={undefined} routes={station.routes} />
	</section>

	<section>
		<h2>{t.adjacent}</h2>
		<ResponsiveTable columns={[adjCols.line, adjCols.prev, adjCols.next]}>
			{station.adjacent.map(a => (
				<tr>
					<TableCell col={adjCols.line}>{getStationNumber(a.route, station.name) && routeColors[a.route] && <CodeBadge code={getStationNumber(a.route, station.name)!} color={routeColors[a.route]} />}{routeName(a.route, lang)}</TableCell>
					<TableCell col={adjCols.prev}>{a.prev ? <StationLink station={a.prev} lang={lang} /> : t.terminal}</TableCell>
					<TableCell col={adjCols.next}>{a.next ? <StationLink station={a.next} lang={lang} /> : t.terminal}</TableCell>
				</tr>
			))}
		</ResponsiveTable>
	</section>

	{station.touristSpots.length > 0 && (
		<section>
			<h2>{t.nearbySpots}</h2>
			{station.touristSpots.map(spot => (
				<Fragment>
					<p>{t.nearbySpotLine(t.spotName(spot))}</p>
					<MapOpenCta
						label={t.openMapSpot(t.spotName(spot), name)}
						kind="tourist"
						guideSlug={`tourist/${spot.id}`}
						language={lang}
						from={station.mapFrom}
						routes={station.routes}
						station={station.name}
						city={spot.city}
						touristSpot={spot.id}
					/>
				</Fragment>
			))}
		</section>
	)}

	{station.stats.length > 0 && (
		<section id="around-stats">
			<h2>{t.aroundStats}</h2>
			<p class="seo-note">{t.statsNote}</p>
			<ResponsiveTable columns={[statCols.item, statCols.value, statCols.scope]}>
				{station.stats.map(s => {
					const page = DATA_LANGS.includes(lang) ? dataPageFor(s.key) : undefined;
					const label = statLabel(s.meta.label, lang);
					return (
						<tr>
							<TableCell col={statCols.item}>{page ? <a href={dataPath(page.slug, lang)}>{label}</a> : label}</TableCell>
							<TableCell col={statCols.value}>{statValue(s.value, s.meta.unit, lang)}</TableCell>
							<TableCell col={statCols.scope}>{t.scope(s.meta.radius, s.meta.period)}</TableCell>
						</tr>
					);
				})}
			</ResponsiveTable>
			<p class="seo-note">
				{t.sources}: {sources.map((src, i) => (
					<Fragment>{i > 0 && ' / '}{src.url && !src.dead ? <a href={src.url} rel="nofollow noopener">{t.sourceTitle(src.title)}</a> : t.sourceTitle(src.title)}{t.retrievedAt(src.retrievedAt)}</Fragment>
				))}
			</p>
		</section>
	)}

	{nearby.length > 0 && (
		<section>
			<h2>{t.nearbyStations}</h2>
			<ul class="seo-chips">
				{nearby.map(s => <li class="seo-chip"><a href={stationPath(s.slug, lang)}>{stationName(s, lang)}</a></li>)}
			</ul>
		</section>
	)}

	{relatedGuides.length > 0 && (
		<section>
			<h2>{t.relatedGuides}</h2>
			<ul class="related-list">
				{relatedGuides.map(g => <li><a href={g.path}>{g.title}</a></li>)}
			</ul>
		</section>
	)}
</SeoPageLayout>
