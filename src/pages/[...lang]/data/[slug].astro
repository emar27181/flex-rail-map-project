---
/**
 * 駅周辺データのページ（/data/{slug}, /en/data/{slug}）。
 * 実データ（dataQuality: 'real'）の指標だけ作る。値の無い駅は0にせず件数だけ示す。
 */
import ResponsiveTable from '../../../components/ui/atoms/ResponsiveTable.astro';
import TableCell from '../../../components/ui/atoms/TableCell.astro';
import type { TableColumn } from '../../../components/ui/atoms/responsiveTable';
import SeoPageLayout from '../../../layouts/SeoPageLayout.astro';
import MapOpenCta from '../../../components/MapOpenCta.astro';
import {
  DATA_LANGS, dataPath, getSeoModel, hubPath, linePath, routeName, stationName, stationPath,
  type SeoDataPage, type SeoLang,
} from '../../../seo/pageModel';
import { SEO_TEXT, statLabel, statValue } from '../../../seo/pageText';

export function getStaticPaths() {
  return DATA_LANGS.flatMap(lang =>
    getSeoModel().dataPages.map(page => ({
      params: { lang: lang === 'ja' ? undefined : lang, slug: page.slug },
      props: { lang, page },
    })),
  );
}

interface Props { lang: SeoLang; page: SeoDataPage }
const { lang, page } = Astro.props;
const t = SEO_TEXT[lang];
const label = statLabel(page.meta.label, lang);
const withUnit = (v: number) => statValue(v, page.meta.unit, lang);
const path = dataPath(page.slug, lang);
const scope = t.scope(page.meta.radius, page.meta.period);
const top = page.rows[0];
// 地図は中央値の高い路線（上位5路線）を表示し、この指標のヒートマップで開く
const dataCta = {
  label: t.openMapData(label),
  kind: 'data' as const,
  guideSlug: `data/${page.slug}`,
  language: lang,
  routes: page.byLine.slice(0, 5).map(s => s.line.key),
  metric: page.key,
};

// 表の列（見せ方は ResponsiveTable の規格）
const lineCols = {
	line: { label: t.colLine, kind: 'title' },
	median: { label: t.colMedian, kind: 'num' },
	max: { label: t.colMax, kind: 'text' },
	count: { label: t.colCount, kind: 'num' },
} satisfies Record<string, TableColumn>;
const rankCols = {
	rank: { label: t.colRank, kind: 'index' },
	station: { label: t.colStation, kind: 'title' },
	value: { label, kind: 'num' },
} satisfies Record<string, TableColumn>;
---

<SeoPageLayout
	lang={lang}
	title={t.dataTitle(label)}
	description={t.dataDescription(label, page.rows.length, scope)}
	path={path}
	langPaths={Object.fromEntries(DATA_LANGS.map(l => [l, dataPath(page.slug, l)]))}
	breadcrumbs={[
		{ name: t.home, path: '/' },
		{ name: t.hubs.data, path: hubPath('data', lang) },
		{ name: label, path },
	]}
	h1={t.dataH1(label)}
	lede={top && t.dataLede(label, page.rows.length, stationName(top.station, lang), withUnit(top.value))}
	indexable={page.indexable}
>
	<p class="seo-note">
		{scope}
		{page.source && (
			<Fragment>
				{' / '}{t.sources}: {page.source.url && !page.source.dead
					? <a href={page.source.url} rel="nofollow noopener">{t.sourceTitle(page.source.title)}</a>
					: t.sourceTitle(page.source.title)}{t.retrievedAt(page.source.retrievedAt)}
			</Fragment>
		)}
	</p>
	{page.missingCount > 0 && <p class="seo-note">{t.missing(page.missingCount)}</p>}

	<MapOpenCta {...dataCta} />

	<section>
		<h2>{t.byLine}</h2>
		<ResponsiveTable columns={[lineCols.line, lineCols.median, lineCols.max, lineCols.count]}>
			{page.byLine.map(s => (
				<tr>
					<TableCell col={lineCols.line}><a href={linePath(s.line.slug, lang)}>{routeName(s.line.key, lang)}</a></TableCell>
					<TableCell col={lineCols.median}>{withUnit(s.median)}</TableCell>
					<TableCell col={lineCols.max}><a href={stationPath(s.max.station.slug, lang)}>{stationName(s.max.station, lang)}</a>{t.paren(withUnit(s.max.value))}</TableCell>
					<TableCell col={lineCols.count}>{s.count}</TableCell>
				</tr>
			))}
		</ResponsiveTable>
		<MapOpenCta {...dataCta} />
	</section>

	<section>
		<h2>{t.ranking}</h2>
		<ResponsiveTable columns={[rankCols.rank, rankCols.station, rankCols.value]}>
			{page.rows.map((r, i) => (
				<tr>
					<TableCell col={rankCols.rank}>{i + 1}</TableCell>
					<TableCell col={rankCols.station}><a href={stationPath(r.station.slug, lang)}>{stationName(r.station, lang)}</a></TableCell>
					<TableCell col={rankCols.value}>{withUnit(r.value)}</TableCell>
				</tr>
			))}
		</ResponsiveTable>
	</section>
</SeoPageLayout>
