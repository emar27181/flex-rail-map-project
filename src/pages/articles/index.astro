---
/**
 * 記事一覧の日本語版（/articles）。英語・中国語・韓国語版は src/pages/[...lang]/articles/index.astro。
 */
import ArticleLayout from "./_ArticleLayout.astro";
import { ARTICLES, ARTICLE_PAGE_TRANSLATIONS } from "../../data/articleI18n";
import { articlePath } from "../../config/articleSeo";

const month = (iso: string) => iso.slice(0, 7).replace("-", "年") + "月";
---

<ArticleLayout pageKey="articles" kind="index">
  <section class="article-index" aria-label={ARTICLE_PAGE_TRANSLATIONS.articles.ja.title}>
    <ul class="article-list">
      {ARTICLES.map(article => {
        const t = ARTICLE_PAGE_TRANSLATIONS[article.slug].ja;
        return (
          <li>
            <a href={articlePath(article.slug, "ja")}>
              <span class="article-card-title">{t.title}</span>
              <span class="meta">{month(article.publishedDate)} ｜ <span>{t.category}</span></span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</ArticleLayout>
