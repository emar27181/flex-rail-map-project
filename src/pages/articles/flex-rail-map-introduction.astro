---
/**
 * 記事の日本語版（/articles/flex-rail-map-introduction）。英語・中国語・韓国語版は src/pages/[...lang]/articles/。
 * タイトル・本文は articleI18n.ts / articleBodyI18n.ts にあり、ここでは記事を指定するだけ。
 */
import "../../styles/article-introduction.css";
import IntroductionDemo from "../../components/articles/IntroductionDemo.astro";
import ArticleLayout from "./_ArticleLayout.astro";
import { ARTICLES } from "../../data/articleI18n";

const article = ARTICLES.find(a => a.slug === "flex-rail-map-introduction")!;
---

<ArticleLayout pageKey={article.slug} publishedDate={article.publishedDate} modifiedDate={article.modifiedDate}>
  <IntroductionDemo slot="beforeArticle" lang="ja" />
</ArticleLayout>
