---
/**
 * 日本語の記事ページ（このフォルダの各ファイル）から使う記事レイアウト。
 * 中身は src/components/articles/ArticleLayout.astro（英語・中国語・韓国語版と共通）で、
 * ここは日本語を指定して渡すだけ。
 */
import ArticleLayout, { type Props as LayoutProps } from "../../components/articles/ArticleLayout.astro";

export type Props = Omit<LayoutProps, "lang">;
---

<ArticleLayout lang="ja" {...Astro.props}>
  <slot name="head" slot="head" />
  <slot name="beforeArticle" slot="beforeArticle" />
  <slot />
  <slot name="scripts" slot="scripts" />
</ArticleLayout>
