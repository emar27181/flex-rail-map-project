---
import GuidesIndexLayout from "../../../layouts/GuidesIndexLayout.astro";
import { getGuidesByLang } from "../../../data/guides";
import { SITE_NAME } from '../../../config/seo';

const koGuides = getGuidesByLang('ko');
---

<GuidesIndexLayout
	title={`가이드 목록 - ${SITE_NAME} | 도쿄 노선도 보는 법`}
	description={`${SITE_NAME}의 한국어 가이드 목록입니다. 도쿄 노선도를 심플하게 보는 방법 등, 각 가이드에서 바로 해당하는 인터랙티브 지도를 열 수 있습니다.`}
	path="/ko/guides"
	htmlLang="ko"
	backLabel={`← ${SITE_NAME}으로 돌아가기`}
>
	<h1 class="page-title">가이드 목록</h1>
	<p class="lede">
	목적별 가이드입니다. 각 가이드에서 해당 내용에 맞는 {SITE_NAME} 지도를 바로 열 수 있습니다.
	</p>
	<ul class="related-list">
		{koGuides.map(g => (
			<li><a href={`/ko/guides/${g.slug}`}>{g.breadcrumbLabel}</a></li>
		))}
	</ul>
</GuidesIndexLayout>
